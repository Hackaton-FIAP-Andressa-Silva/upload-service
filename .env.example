APP_NAME=upload-service
DEBUG=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/upload_db

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT_URL=  # Leave empty for real AWS, set to http://localhost:4566 for LocalStack

# S3
S3_BUCKET_NAME=architecture-diagrams

# SQS
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/diagram-analysis-queue

# Internal auth
INTERNAL_SERVICE_TOKEN=change-me-in-production
